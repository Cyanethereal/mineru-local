{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/mineru-local/mineru-artifact-manifest.schema.json",
  "title": "MinerUArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "generated_at",
    "generator",
    "execution",
    "input",
    "status",
    "markdown",
    "assets",
    "other_files",
    "warnings",
    "errors",
    "output_tree"
  ],
  "properties": {
    "manifest_schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "mineru-local"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "environment",
        "backend",
        "method",
        "io_mode",
        "returncode"
      ],
      "properties": {
        "environment": {
          "enum": [
            "windows",
            "wsl",
            "unknown"
          ]
        },
        "requested_environment": {
          "type": [
            "string",
            "null"
          ]
        },
        "backend": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "io_mode": {
          "enum": [
            "native",
            "staged"
          ]
        },
        "wsl_distro": {
          "type": [
            "string",
            "null"
          ]
        },
        "mineru_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "executable": {
          "type": [
            "string",
            "null"
          ]
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        },
        "returncode": {
          "type": "integer"
        },
        "fallback": {
          "type": "object"
        },
        "config_sources": {
          "type": "object"
        },
        "stdout_tail": {
          "type": "string"
        },
        "stderr_tail": {
          "type": "string"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "suffix",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "failed"
      ]
    },
    "markdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary",
        "candidates",
        "selection"
      ],
      "properties": {
        "primary": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/markdown_artifact"
            }
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/markdown_artifact"
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "primary_path",
            "reason"
          ],
          "properties": {
            "rule": {
              "type": "string"
            },
            "primary_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes",
          "sha256",
          "referenced",
          "referenced_by",
          "media_type"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "referenced": {
            "type": "boolean"
          },
          "referenced_by": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/relative_path"
            }
          },
          "media_type": {
            "type": "string"
          }
        }
      }
    },
    "other_files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/relative_path"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    },
    "output_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "entry_count",
        "excludes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "markdown_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256",
        "line_count",
        "is_primary"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "line_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "is_primary": {
          "type": "boolean"
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "details"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
